---
profile: production
exclude_paths:
  - tools/
  - docs/openapi/
  - .superpowers/
  - .ansible/
  - .venv/
  - changelogs/changelog.yaml  # generated by antsibull-changelog
skip_list:
  # requires_ansible >=2.20.0 is intentional; ansible-lint's supported-version list lags behind ansible-core.
  - meta-runtime[unsupported-version]
