# Template for the live-lab connection settings. Copy to .env (git-ignored) and fill in.
#   cp .env.example .env && chmod 600 .env
# Load it with uv:   uv run --env-file .env ansible-playbook ...
# or in a shell:     set -a; source .env; set +a
# Never commit .env, never paste its values into chat, logs or issues.

PPDM_HOSTNAME=
PPDM_USERNAME=admin
PPDM_PASSWORD=
PPDM_PORT=8443
